legend [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="5"><TR><TD ALIGN="LEFT"><B>LECTURA</B></TD></TR><TR><TD ALIGN="LEFT">A → B: A por B : registros B por A</TD></TR><TR><TD ALIGN="LEFT">1 = obligatorio · 0..1 = opcional · 0..N = cero o muchos</TD></TR><TR><TD ALIGN="LEFT">PK = clave primaria · FK = foránea · UK = unicidad individual</TD></TR><TR><TD ALIGN="LEFT">NN = NOT NULL · NULL = opcional · ¹ = SERIAL / secuencia</TD></TR><TR><TD ALIGN="LEFT">Línea continua: FK parte de PK · discontinua: FK no identificadora</TD></TR><TR><TD ALIGN="LEFT">Unicidad compuesta e índices UPPER: detalle en Markdown físico</TD></TR></TABLE>>];
{ rank=same; legend; movimiento_equipo; mantenimiento; }
